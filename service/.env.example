# Gemini-Schlüssel aus Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...

# Modell – nur setzen, wenn du den Default überschreiben willst.
# Default lebt in service/app/agent.py (google-gla:gemini-3-pro-preview).
# Beispiel-Override:
#   MODEL_ID=google-gla:gemini-2.5-flash

# Komma-getrennte Liste "code:label,code:label"
# Label landet im Log und im Token-Budget-Key
ACCESS_CODES=demo123:gast,bera456:berater_mueller

# Random Bytes (z.B. python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=change-me

# Cookie-Sicherheit – auf "false" setzen, um lokal ohne HTTPS zu testen
COOKIE_SECURE=true

# Token-Budget pro Access-Label (Lifetime, Input+Output zusammen).
# Aufgebraucht = endgültig gesperrt; Reset via "redis-cli DEL tokens:<label>".
TOKEN_CAP_PER_LABEL=100000

# Redis – auf Railway via Plugin automatisch
REDIS_URL=redis://localhost:6379/0

# Wo das Wiki im Container liegt (im Image: /app/wiki)
WIKI_ROOT=/app/wiki

# Logfire (optional) – Token von https://logfire.pydantic.dev
# Ohne Token läuft der Service ohne Tracing weiter.
LOGFIRE_TOKEN=
